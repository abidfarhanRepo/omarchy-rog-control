<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/software/polkit/policyconfig-1.dtd">

<!--
  Lets the user sitting at the machine set the battery charge limit without a
  password, using polkit rather than a sudoers rule.

  allow_active is "yes" and allow_inactive is "no": only a local, active
  session qualifies. A remote or background session still has to authenticate
  as an administrator. The privilege is bound to one absolute path, and that
  helper accepts only a fixed set of charge levels, so the grant cannot be
  widened by argument.
-->
<policyconfig>
  <vendor>ROG control</vendor>
  <vendor_url>https://github.com/abidfarhanRepo/omarchy-rog-control</vendor_url>

  <action id="org.omarchy.rogcontrol.set-charge-limit">
    <description>Set the battery charge limit</description>
    <message>Authentication is required to change the battery charge limit</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/local/bin/rog-charge-limit</annotate>
    <annotate key="org.freedesktop.policykit.exec.allow_gui">true</annotate>
  </action>
</policyconfig>
