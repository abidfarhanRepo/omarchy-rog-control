#!/bin/bash
# Apply one ROG setting. Single entry point for everything the panel can
# change, so the privilege story lives in one auditable place.
#
#   profile <power-saver|balanced|performance|quiet|turbo>
#       power-profiles-daemon over D-Bus. No root.
#   kbd <level>
#       brightnessctl, which is logind/udev-backed. No root.
#   cap <50|60|70|80|90|100>
#       a direct write to the battery's charge_control_end_threshold.
#
# There is deliberately no privileged path here: no sudo, no pkexec, no setuid
# helper, and no installer. Granting the write is a udev rule the user installs
# themselves (see the README); this plugin never ships code that runs as root,
# so nothing root-owned ever reads or executes a file from this user-writable
# checkout.
set -uo pipefail

usage() { echo "usage: rog-set profile <name> | cap <50..100> | kbd <n>" >&2; exit 2; }
(( $# == 2 )) || usage

case "$1" in
  profile)
    # ACPI and power-profiles-daemon use different vocabularies for the same
    # three states ("quiet" vs "power-saver"). Normalise, or the switch
    # silently no-ops.
    case "$2" in
      quiet|power-saver)      prof=power-saver ;;
      balanced)               prof=balanced ;;
      performance|turbo)      prof=performance ;;
      *) usage ;;
    esac
    exec omarchy-powerprofiles-set autodetect "$prof"
    ;;

  cap)
    case "$2" in 50|60|70|80|90|100) ;; *) usage ;; esac
    for b in /sys/class/power_supply/BAT*; do
      [[ -e $b/charge_control_end_threshold ]] || continue
      if [[ -w $b/charge_control_end_threshold ]]; then
        echo "$2" > "$b/charge_control_end_threshold" && exit 0
      fi
      echo "charge_control_end_threshold is not writable by this user." >&2
      echo "See the README: install the udev rule that grants group write." >&2
      exit 1
    done
    echo "no battery exposes charge_control_end_threshold" >&2
    exit 1
    ;;

  kbd)
    [[ $2 =~ ^[0-9]+$ ]] || usage
    dev=""
    for c in /sys/class/leds/*kbd_backlight*; do [[ -e $c ]] && { dev=$(basename "$c"); break; }; done
    [[ -n $dev ]] || { echo "no keyboard backlight device" >&2; exit 1; }
    exec brightnessctl -q -d "$dev" set "$2"
    ;;

  *) usage ;;
esac
